# Reference only: no dotenv loader is installed. Set process environment explicitly.
# Choose a NEW EMPTY PRIVATE persistent local directory; do not use static/public.
CVAT_UPLOAD_DIR=
# Generate independently, keep stable in an operator secret store across restarts.
CVAT_UPLOAD_SECRET=
# JSON map of owner IDs to unique high-entropy keys (32+ characters). Never commit real keys.
CVAT_UPLOAD_OWNER_KEYS_JSON={}
CVAT_MAX_UPLOAD_BYTES=53687091200
CVAT_CHUNK_BYTES=8388608
CVAT_STORAGE_QUOTA_BYTES=107374182400
CVAT_MIN_FREE_BYTES=10737418240
CVAT_UPLOAD_IDLE_SECONDS=259200
CVAT_UPLOAD_LIFETIME_SECONDS=604800
